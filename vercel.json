{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "crons": [
    {
      "path": "/api/cron/sync-erp",
      "schedule": "0 7 * * *"
    }
  ],

  "functions": {
    "src/app/api/cron/sync-erp/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/upload/route.ts": {
      "maxDuration": 30
    }
  }
}
